      replacement_content: "        {/* HERO PORTFOLIO CONTENT CARDS */}\n        <div className=\"relative z-20 text-center max-w-5xl px-6 flex flex-col items-center mt-auto mb-2 w-full\">\n          \n          {/* Creative Luxury Floating Badge */}\n          <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.03] border border-white/10 backdrop-blur-xl mb-6 shadow-[0_4px_30px_rgba(0,0,0,0.4)] animate-pulse\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-accent-red animate-ping shadow-[0_0_8px_#ff3322]\" />\n            <span className=\"text-[9px] font-mono tracking-[0.25em] text-zinc-300 uppercase\">INTERACTIVE DESIGN ATELIER</span>\n          </div>\n\n          {/* Pristine majestic title text with larger, elegant editorial scaling */}\n          <h1 className=\"text-6xl sm:text-8xl md:text-[8rem] lg:text-[8.5rem] font-serif text-white font-light tracking-tighter leading-none select-none mb-1 drop-shadow-[0_4px_20px_rgba(0,0,0,0.85)]\">\n            Sohaib Elahi\n          </h1>\n\n          {/* Highly readable, enhanced bigger body typography layout */}\n          <p className=\"max-w-2xl text-sm sm:text-base md:text-[16.5px] text-zinc-200 font-normal mt-5 leading-relaxed antialiased tracking-wide mx-auto drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)] px-4\">\n            Marketing designer engineering visual conversions. I construct elegant typographical grids, \n            high-rebound Klaviyo structures, and digital storefront layouts that arrest attention in 0.8 seconds.\n          </p>\n\n          {/* Symmetrical Dual Glowing CTA Action Row */}\n          <div className=\"mt-8 mb-6 flex flex-col sm:flex-row items-center justify-center gap-4 z-30 pointer-events-auto\">\n            <button\n              onClick={() => setIsContactOpen(true)}\n              className=\"cursor-none px-8 py-3.5 rounded-full bg-accent-red text-white border border-accent-red/40 hover:bg-[#e03227] hover:border-[#ff4a3d] hover:shadow-[0_0_25px_rgba(201,54,46,0.5)] active:scale-95 transition-all duration-300 text-xs font-mono tracking-[0.2em] uppercase font-bold\"\n            >\n              Initiate Briefing\n            </button>\n            <a\n              href=\"#showcase-carousel\"\n              onClick={(e) => {\n                e.preventDefault();\n                const el = document.getElementById(\"showcase-carousel\");\n                el?.scrollIntoView({ behavior: \"smooth\" });\n              }}\n              className=\"cursor-none px-8 py-3.5 rounded-full bg-white/[0.04] text-zinc-100 border border-white/10 hover:bg-white/[0.08] hover:border-white/20 active:scale-95 transition-all duration-300 text-xs font-mono tracking-[0.2em] uppercase font-semibold\"\n            >\n              Explore Showcase\n            </a>\n          </div>\n\n          {/* Highly Visible Dynamic Scroll Explore Indicator */}\n          <div className=\"flex flex-col items-center mt-6 text-white font-mono select-none pointer-events-none z-30\">\n            <span className=\"text-[10px] tracking-[0.3em] text-[#888] font-medium uppercase\">\n              REEL SEQUENCE BELOW\n            </span>\n            <motion.div \n              animate={{ y: [0, 8, 0] }}\n              transition={{ repeat: Infinity, duration: 1.6, ease: \"easeInOut\" }}\n              className=\"mt-3 w-1.5 h-1.5 rounded-full bg-accent-red shadow-[0_0_10px_rgba(201,54,46,0.85)] animate-pulse\"\n            />\n            <div className=\"w-[1.5px] h-10 bg-gradient-to-b from-accent-red via-accent-red/30 to-transparent mt-2 opacity-50\" />\n          </div>\n        </div>"
