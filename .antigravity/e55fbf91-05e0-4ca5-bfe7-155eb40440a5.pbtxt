    instruction: "Make the showcase carousel container shorter, push it lower, make the images smaller and give them highly rounded corners."
    replacement_infos {
      original_chunk {
        target_content: "        {/* 3. SHADOW-FREE CAROUSEL SHOWCASE (FEWER, LOWER PROFILE AND ROUNDED IMAGES) */}\n        <div className=\"relative z-20 w-screen h-44 sm:h-56 mt-auto mb-2 flex items-center\">\n          \n          {/* Marquee scrollable strip containing fewer columns with massive, epic cards */}\n          <div className=\"flex w-[200vw] overflow-hidden whitespace-nowrap hover-pause select-none\">\n            <div className=\"flex gap-8 pr-8 animate-marquee-slow\">\n              \n              {/* Set 1 */}\n              {SHOWCASE_CARDS.map((card, idx) => (\n                <div\n                  key={`marq1-${card.id}-${idx}`}\n                  className=\"relative flex-none w-[110px] h-[145px] sm:w-[150px] sm:h-[195px] rounded-lg sm:rounded-xl overflow-hidden pointer-events-none aspect-[4/5] border border-white/5 shadow-md\"\n                >\n                  <img\n                    referrerPolicy=\"no-referrer\"\n                    src={card.imageUrl}\n                    alt={card.title}\n                    className=\"absolute inset-0 w-full h-full object-cover opacity-100\"\n                  />\n                </div>\n              ))}\n\n              {/* Set 2 (Symmetric Infinite Loop) */}\n              {SHOWCASE_CARDS.map((card, idx) => (\n                <div\n                  key={`marq2-${card.id}-${idx}`}\n                  className=\"relative flex-none w-[110px] h-[145px] sm:w-[150px] sm:h-[195px] rounded-lg sm:rounded-xl overflow-hidden pointer-events-none aspect-[4/5] border border-white/5 shadow-md\"\n                >\n                  <img\n                    referrerPolicy=\"no-referrer\"\n                    src={card.imageUrl}\n                    alt={card.title}\n                    className=\"absolute inset-0 w-full h-full object-cover opacity-100\"\n                  />\n                </div>\n              ))}"
        replacement_content: "        {/* 3. SHADOW-FREE CAROUSEL SHOWCASE (FEWER, LOWER PROFILE AND ROUNDED IMAGES) */}\n        <div className=\"relative z-20 w-screen h-32 sm:h-40 mt-auto mb-1 flex items-center\">\n          \n          {/* Marquee scrollable strip containing fewer columns with massive, epic cards */}\n          <div className=\"flex w-[200vw] overflow-hidden whitespace-nowrap hover-pause select-none\">\n            <div className=\"flex gap-6 pr-6 animate-marquee-slow\">\n              \n              {/* Set 1 */}\n              {SHOWCASE_CARDS.map((card, idx) => (\n                <div\n                  key={`marq1-${card.id}-${idx}`}\n                  className=\"relative flex-none w-[75px] h-[100px] sm:w-[110px] sm:h-[145px] rounded-xl sm:rounded-2xl overflow-hidden pointer-events-none aspect-[4/5] border border-white/5 shadow-md transition-all duration-300\"\n                >\n                  <img\n                    referrerPolicy=\"no-referrer\"\n                    src={card.imageUrl}\n                    alt={card.title}\n                    className=\"absolute inset-0 w-full h-full object-cover opacity-100\"\n                  />\n                </div>\n              ))}\n\n              {/* Set 2 (Symmetric Infinite Loop) */}\n              {SHOWCASE_CARDS.map((card, idx) => (\n                <div\n                  key={`marq2-${card.id}-${idx}`}\n                  className=\"relative flex-none w-[75px] h-[100px] sm:w-[110px] sm:h-[145px] rounded-xl sm:rounded-2xl overflow-hidden pointer-events-none aspect-[4/5] border border-white/5 shadow-md transition-all duration-300\"\n                >\n                  <img\n                    referrerPolicy=\"no-referrer\"\n                    src={card.imageUrl}\n                    alt={card.title}\n                    className=\"absolute inset-0 w-full h-full object-cover opacity-100\"\n                  />\n                </div>\n              ))}"
      }
