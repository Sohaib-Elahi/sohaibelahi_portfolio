  file_change {
    absolute_path_uri: "file:///src/components/PhoenixParticles.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useRef } from \"react\";\nimport * as THREE from \"three\";\n\nexport default function PhoenixParticles() {\n  const containerRef = useRef<HTMLDivElement | null>(null);\n\n  useEffect(() => {\n    const container = containerRef.current;\n    if (!container) return;\n\n    // Standard high performance 3D scene setup\n    const scene = new THREE.Scene();\n    \n    const width = container.clientWidth;\n    const height = container.clientHeight;\n    \n    // Clean perspective camera for deep orthographic look\n    const camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 100);\n    camera.position.z = 4.8;\n\n    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });\n    renderer.setSize(width, height);\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n    container.appendChild(renderer.domElement);\n\n    // Procedural generation of sharp Mockingjay particles\n    const particleCount = 22000;\n    const geometry = new THREE.BufferGeometry();\n    \n    const positions = new Float32Array(particleCount * 3);\n    const initialPositions = new Float32Array(particleCount * 3);\n    const colors = new Float32Array(particleCount * 3);\n    const initialColors = new Float32Array(particleCount * 3);\n    const sizes = new Float32Array(particleCount);\n    const customData = new Float32Array(particleCount * 4); // [speed, offset, angleOffset, particleSectionType]\n\n    // Cozy, extremely dim ambient embers (subtle and luxurious)\n    const cDimBurgundy = new THREE.Color(\"#180203\");\n    const cDimCharcoal = new THREE.Color(\"#0c0708\");\n    const cMutedRust = new THREE.Color(\"#4a0e0f\");\n\n    for (let i = 0; i < particleCount; i++) {\n      let x = 0, y = 0, z = 0;\n      let sectType = 1; // 1=Body/Head, 2=Left Wing, 3=Right Wing, 4=Tail\n      const rSect = Math.random();\n\n      if (rSect < 0.20) {\n        // A. PERFECT SYMMETRICAL CORE BIRD BODY & HEAD (20%)\n        sectType = 1;\n        const t = Math.random(); \n        y = -0.8 + 1.6 * t; // Body height span\n        \n        // Symmetrical chest taper curve\n        const bodyWidth = 0.14 * Math.sin(t * Math.PI) * (1.1 - 0.3 * t);\n        x = (Math.random() - 0.5) * bodyWidth;\n        z = (Math.random() - 0.5) * 0.08 * (1.0 - t);\n\n        if (t > 0.86) {\n          // Sharp Noble Head with classic upward-right beak\n          const headProgress = (t - 0.86) / 0.14;\n          x += headProgress * 0.14;\n          y += headProgress * 0.04;\n        }\n      } else if (rSect < 0.85) {\n        // B. SHARP MOUNTED WINGS WITH DETAILED INDIVIDUAL FEATHER SPLINES (65%)\n        const isLeft = Math.random() < 0.5;\n        sectType = isLeft ? 2 : 3;\n        const sign = isLeft ? -1 : 1;\n\n        // Choose a random feather strand to build crisp structural definition\n        const featherID = Math.floor(Math.random() * 14); \n        const u = Math.random(); // Position along the wing spine\n\n        // Wing base bone curving upward elegantly\n        const wingX = sign * (0.05 + 1.55 * Math.pow(u, 0.72));\n        const wingY = -0.15 + 1.48 * Math.pow(u, 1.1) + 0.25 * Math.sin(u * Math.PI);\n\n        // Individual feather branch offset calculations\n        const angleFactor = (featherID / 13) * 0.85 - 0.3;\n        const fanAngle = sign * (1.1 + angleFactor) * 1.57; // Radiate outwards\n        const featherLength = (0.16 + 0.84 * Math.pow(1.0 - u, 0.55)) * (0.15 + 0.85 * Math.random());\n\n        x = wingX + Math.cos(fanAngle) * featherLength;\n        y = wingY + Math.sin(fanAngle) * featherLength;\n        z = (Math.random() - 0.5) * 0.06 - u * 0.18;\n      } else {\n        // C. CASCADING TAIL STREAMERS (15%)\n        sectType = 4;\n        const t = Math.random();\n        y = -0.8 - 0.95 * t;\n\n        const streamerBranch = Math.floor(Math.random() * 4);\n        const sign = Math.random() < 0.5 ? -1 : 1;\n\n        // Tapered waving streamer lines\n        const waveX = sign * (0.03 + 0.45 * Math.pow(t, 1.35)) * (0.5 + 0.5 * streamerBranch);\n        x = waveX + (Math.random() - 0.5) * 0.03;\n        z = (Math.random() - 0.5) * 0.04 * (1.0 - t);\n      }\n\n      // Store initial positions\n      positions[i * 3] = x;\n      positions[i * 3 + 1] = y;\n      positions[i * 3 + 2] = z;\n\n      initialPositions[i * 3] = x;\n      initialPositions[i * 3 + 1] = y;\n      initialPositions[i * 3 + 2] = z;\n\n      // Assign subtle, dim base palette\n      let baseColor = cDimCharcoal;\n      const cChance = Math.random();\n      if (sectType === 1) {\n        // Body slightly warmer ember\n        baseColor = cChance < 0.6 ? cDimBurgundy : cMutedRust;\n      } else if (sectType === 4) {\n        // Tail is shadowy charcoal\n        baseColor = cChance < 0.5 ? cDimCharcoal : cDimBurgundy;\n      } else {\n        // Wings transition to faint burgundy outline\n        baseColor = cChance < 0.7 ? cDimBurgundy : cMutedRust;\n      }\n\n      colors[i * 3] = baseColor.r;\n      colors[i * 3 + 1] = baseColor.g;\n      colors[i * 3 + 2] = baseColor.b;\n\n      initialColors[i * 3] = baseColor.r;\n      initialColors[i * 3 + 1] = baseColor.g;\n      initialColors[i * 3 + 2] = baseColor.b;\n\n      // EXTREMELY SMALL, elegant micro-dots\n      sizes[i] = 0.5 + Math.random() * 1.3;\n\n      customData[i * 4] = 0.55 + Math.random() * 1.15; // speed multiplier\n      customData[i * 4 + 1] = Math.random() * Math.PI * 2; // initial phase\n      customData[i * 4 + 2] = (Math.random() < 0.5 ? -1.0 : 1.0) * (0.12 + Math.random() * 0.3); // direction\n      customData[i * 4 + 3] = sectType; // identifier\n    }\n\n    geometry.setAttribute(\"position\", new THREE.BufferAttribute(positions, 3));\n    geometry.setAttribute(\"color\", new THREE.BufferAttribute(colors, 3));\n    geometry.setAttribute(\"aSize\", new THREE.BufferAttribute(sizes, 1));\n\n    // High performance Points material\n    const material = new THREE.PointsMaterial({\n      size: 0.018, // VERY SMALL pristine micro-particles\n      vertexColors: true,\n      transparent: true,\n      opacity: 0.85,\n      blending: THREE.AdditiveBlending,\n      depthWrite: false,\n    });\n\n    // Custom shader compile overrides to render perfectly round glowing plasma spikes\n    material.onBeforeCompile = (shader) => {\n      shader.vertexShader = shader.vertexShader.replace(\n        \"void main() {\",\n        `\n        attribute float aSize;\n        void main() {\n        `\n      );\n      shader.vertexShader = shader.vertexShader.replace(\n        \"gl_PointSize = size;\",\n        \"gl_PointSize = size * aSize;\"\n      );\n      shader.fragmentShader = shader.fragmentShader.replace(\n        \"void main() {\",\n        `\n        void main() {\n          vec2 center = gl_PointCoord - vec2(0.5);\n          float dist = length(center);\n          if (dist > 0.5) discard;\n          float alpha = smoothstep(0.5, 0.08, dist);\n        `\n      );\n      shader.fragmentShader = shader.fragmentShader.replace(\n        \"gl_FragColor = vec4( diffuseColor.rgb, diffuseColor.a );\",\n        \"gl_FragColor = vec4( diffuseColor.rgb, diffuseColor.a * alpha * 1.45 );\"\n      );\n    };\n\n    const points = new THREE.Points(geometry, material);\n    scene.add(points);\n\n    // Track mouse interaction properties\n    const mouse = { x: 0, y: 0, targetX: 0, targetY: 0, active: false };\n\n    const handleMouseMove = (event: MouseEvent) => {\n      mouse.targetX = (event.clientX / window.innerWidth) * 2 - 1;\n      mouse.targetY = -(event.clientY / window.innerHeight) * 2 + 1;\n      mouse.active = true;\n    };\n\n    window.addEventListener(\"mousemove\", handleMouseMove, { passive: true });\n\n    // Handle Resize events securely\n    const resizeObserver = new ResizeObserver((entries) => {\n      for (let entry of entries) {\n        const w = entry.contentRect.width;\n        const h = entry.contentRect.height;\n        camera.aspect = w / h;\n        camera.updateProjectionMatrix();\n        renderer.setSize(w, h);\n      }\n    });\n    resizeObserver.observe(container);\n\n    // Dynamic rendering loop\n    const clock = new THREE.Clock();\n    let reqId: number;\n\n    // Glowing Neon Active fire color palette\n    const cActiveGold = new THREE.Color(\"#f5ab16\");\n    const cActiveScarlet = new THREE.Color(\"#d31610\");\n    const cActiveCrimson = new THREE.Color(\"#950406\");\n\n    const animate = () => {\n      reqId = requestAnimationFrame(animate);\n\n      const elapsedTime = clock.getElapsedTime();\n      \n      // Interpolate mouse smoothly (Euler decay)\n      mouse.x += (mouse.targetX - mouse.x) * 0.08;\n      mouse.y += (mouse.targetY - mouse.y) * 0.08;\n\n      // Sclera front angle perspective with subtle responsive interactive tilt (No ongoing auto rotation)\n      if (points) {\n        points.rotation.y = mouse.x * 0.22;\n        points.rotation.x = -0.05 + mouse.y * 0.12;\n        // Whisper constant hover float\n        points.position.y = Math.sin(elapsedTime * 0.85) * 0.035;\n      }\n\n      const posArray = geometry.attributes.position.array as Float32Array;\n      const colorArray = geometry.attributes.color.array as Float32Array;\n      const count = posArray.length / 3;\n\n      for (let i = 0; i < count; i++) {\n        const idx = i * 3;\n        \n        const ix = initialPositions[idx];\n        const iy = initialPositions[idx + 1];\n        const iz = initialPositions[idx + 2];\n\n        const speed = customData[i * 4];\n        const phaseOffset = customData[i * 4 + 1];\n        const spinMultiplier = customData[i * 4 + 2];\n        const type = customData[i * 4 + 3];\n\n        let targetX = ix;\n        let targetY = iy;\n        let targetZ = iz;\n\n        // Subtle, elegant micro wave motion\n        if (type === 2 || type === 3) {\n          // Soft upstretch wing flutter\n          const flap = Math.sin(elapsedTime * 1.8 * speed + phaseOffset) * 0.045;\n          targetY += flap;\n          targetZ += flap * (type === 2 ? -0.5 : 0.5);\n        } else if (type === 4) {\n          // Elegant waving tail streamer ribbons\n          targetX += Math.sin(iy * 2.2 + elapsedTime * 1.6 * speed) * 0.04;\n          targetZ += Math.cos(elapsedTime * 1.2 + phaseOffset) * 0.03;\n        } else {\n          // Warm body core heat ripple\n          targetX += Math.sin(elapsedTime * 3.0 + phaseOffset) * 0.005;\n          targetY += Math.cos(elapsedTime * 3.0 + phaseOffset) * 0.005;\n        }\n\n        let proximityIntensity = 0;\n\n        // Tactile mouse attraction & active glowing trails\n        if (mouse.active) {\n          const mouseWorldX = mouse.x * 3.2;\n          const mouseWorldY = mouse.y * 2.5;\n\n          const dx = mouseWorldX - posArray[idx];\n          const dy = mouseWorldY - posArray[idx + 1];\n          const dz = 0.0 - posArray[idx + 2];\n          const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);\n\n          if (dist < 1.7) {\n            // High rebound whirlpool vortex swirl\n            const pullFactor = Math.pow((1.7 - dist) / 1.7, 1.4);\n            proximityIntensity = pullFactor; // illuminate when mouse goes around\n\n            const vortexStrength = pullFactor * 0.5;\n            const swirlX = -dy * vortexStrength * 0.8 * (spinMultiplier > 0 ? 1 : -1);\n            const swirlY = dx * vortexStrength * 0.8 * (spinMultiplier > 0 ? 1 : -1);\n\n            targetX += dx * vortexStrength * 0.5 + swirlX;\n            targetY += dy * vortexStrength * 0.5 + swirlY;\n            targetZ += dz * vortexStrength * 0.3;\n          }\n        }\n\n        // Extremely comfortable Euler spring mechanics\n        posArray[idx] += (targetX - posArray[idx]) * 0.12;\n        posArray[idx + 1] += (targetY - posArray[idx + 1]) * 0.12;\n        posArray[idx + 2] += (targetZ - posArray[idx + 2]) * 0.12;\n\n        // Subtle dynamic color highlight projection\n        // Particles transition from dim/subtle to burning hot red/gold depending on mouse proximity\n        const baseR = initialColors[idx];\n        const baseG = initialColors[idx + 1];\n        const baseB = initialColors[idx + 2];\n\n        // Saturated ignite colors\n        const activeColor = type === 1 ? cActiveGold : (spinMultiplier > 0 ? cActiveScarlet : cActiveCrimson);\n\n        colorArray[idx] += (THREE.MathUtils.lerp(baseR, activeColor.r, proximityIntensity) - colorArray[idx]) * 0.12;\n        colorArray[idx + 1] += (THREE.MathUtils.lerp(baseG, activeColor.g, proximityIntensity) - colorArray[idx + 1]) * 0.12;\n        colorArray[idx + 2] += (THREE.MathUtils.lerp(baseB, activeColor.b, proximityIntensity) - colorArray[idx + 2]) * 0.12;\n      }\n\n      geometry.attributes.position.needsUpdate = true;\n      geometry.attributes.color.needsUpdate = true;\n      renderer.render(scene, camera);\n    };\n\n    animate();\n\n    return () => {\n      cancelAnimationFrame(reqId);\n      window.removeEventListener(\"mousemove\", handleMouseMove);\n      resizeObserver.disconnect();\n      if (renderer && renderer.domElement && container.contains(renderer.domElement)) {\n        container.removeChild(renderer.domElement);\n      }\n      geometry.dispose();\n      material.dispose();\n    };\n  }, []);\n\n  return (\n    <div \n      ref={containerRef} \n      className=\"absolute inset-0 w-full h-full pointer-events-none z-10\" \n      style={{ mixBlendMode: \"screen\" }}\n    />\n  );\n}\n"
