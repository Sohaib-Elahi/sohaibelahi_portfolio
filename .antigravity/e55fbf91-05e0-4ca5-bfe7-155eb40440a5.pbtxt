    replacement_infos {
      original_chunk {
        target_content: "        {/* 3. SHADOW-FREE CAROUSEL SHOWCASE (EXACTLY 10 COLUMNS INTEGRATED SEAMLESSLY) */}\n        <div className=\"relative z-20 w-full h-32 sm:h-40 mt-auto mb-1 flex items-center overflow-hidden\">\n          \n          {/* Marquee dual-track row: Side-by-side elements sliding perfectly at exactly equal rates */}\n          <div className=\"flex w-full overflow-hidden whitespace-nowrap hover-pause select-none relative\">\n            \n            {/* Set 1 */}\n            <div className=\"flex gap-6 pr-6 shrink-0 animate-marquee-slow\">\n              {SHOWCASE_CARDS.map((card, idx) => (\n                <div\n                  key={`marq1-${card.id}-${idx}`}\n                  className=\"relative flex-none w-[75px] h-[100px] sm:w-[110px] sm:h-[145px] rounded-xl sm:rounded-2xl overflow-hidden pointer-events-none aspect-[4/5] border border-white/5 shadow-md\"\n                >\n                  <img\n                    referrerPolicy=\"no-referrer\"\n                    src={card.imageUrl}\n                    alt={card.title}\n                    className=\"absolute inset-0 w-full h-full object-cover opacity-100\"\n                  />\n                </div>\n              ))}\n            </div>\n\n            {/* Set 2 (Symmetric Duplicated Clone) */}\n            <div className=\"flex gap-6 pr-6 shrink-0 animate-marquee-slow\" aria-hidden=\"true\">\n              {SHOWCASE_CARDS.map((card, idx) => (\n                <div\n                  key={`marq2-${card.id}-${idx}`}\n                  className=\"relative flex-none w-[75px] h-[100px] sm:w-[110px] sm:h-[145px] rounded-xl sm:rounded-2xl overflow-hidden pointer-events-none aspect-[4/5] border border-white/5 shadow-md\"\n                >\n                  <img\n                    referrerPolicy=\"no-referrer\"\n                    src={card.imageUrl}\n                    alt={card.title}\n                    className=\"absolute inset-0 w-full h-full object-cover opacity-100\"\n                  />\n                </div>\n              ))}\n            </div>\n\n          </div>\n        </div>"
        replacement_content: "        {/* 3. SHADOW-FREE CAROUSEL SHOWCASE (SLIGHTLY LARGER CARD VISUALS FOR REMARKABLE ENGAGEMENT) */}\n        <div className=\"relative z-20 w-full h-36 sm:h-52 mt-auto mb-2 flex items-center overflow-hidden\">\n          \n          {/* Marquee dual-track row: Side-by-side elements sliding perfectly at exactly equal rates */}\n          <div className=\"flex w-full overflow-hidden whitespace-nowrap hover-pause select-none relative\">\n            \n            {/* Set 1 */}\n            <div className=\"flex gap-6 pr-6 shrink-0 animate-marquee-slow\">\n              {REPEATED_SHOWCASE_CARDS.map((card, idx) => (\n                <div\n                  key={`marq1-${card.id}-${idx}`}\n                  className=\"relative flex-none w-[105px] h-[135px] sm:w-[150px] sm:h-[195px] rounded-xl sm:rounded-2xl overflow-hidden pointer-events-none aspect-[4/5] border border-white/5 shadow-md\"\n                >\n                  <img\n                    referrerPolicy=\"no-referrer\"\n                    src={card.imageUrl}\n                    alt={card.title}\n                    className=\"absolute inset-0 w-full h-full object-cover opacity-100\"\n                  />\n                </div>\n              ))}\n            </div>\n\n            {/* Set 2 (Symmetric Duplicated Clone) */}\n            <div className=\"flex gap-6 pr-6 shrink-0 animate-marquee-slow\" aria-hidden=\"true\">\n              {REPEATED_SHOWCASE_CARDS.map((card, idx) => (\n                <div\n                  key={`marq2-${card.id}-${idx}`}\n                  className=\"relative flex-none w-[105px] h-[135px] sm:w-[150px] sm:h-[195px] rounded-xl sm:rounded-2xl overflow-hidden pointer-events-none aspect-[4/5] border border-white/5 shadow-md\"\n                >\n                  <img\n                    referrerPolicy=\"no-referrer\"\n                    src={card.imageUrl}\n                    alt={card.title}\n                    className=\"absolute inset-0 w-full h-full object-cover opacity-100\"\n                  />\n                </div>\n              ))}\n            </div>\n\n          </div>\n        </div>"
