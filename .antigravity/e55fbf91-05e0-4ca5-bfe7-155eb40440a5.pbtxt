      replacement_content: "                  <form onSubmit={handleSubmit} className=\"space-y-4\">\n                    <div>\n                      <div className=\"flex justify-between items-center mb-1\">\n                        <label htmlFor=\"name\" className=\"block text-[8px] font-mono text-zinc-400 uppercase tracking-widest font-semibold\">\n                          Full Name\n                        </label>\n                        <span className=\"text-[7.5px] font-mono text-zinc-600\">REQUIRED *</span>\n                      </div>\n                      <input\n                        id=\"name\"\n                        type=\"text\"\n                        required\n                        value={name}\n                        onChange={(e) => setName(e.target.value)}\n                        placeholder=\"Alexander\"\n                        className=\"w-full bg-[#030304] border border-white/5 focus:border-accent-red/40 text-xs text-white px-3.5 py-3 rounded-lg focus:ring-1 focus:ring-accent-red/30 focus:bg-[#060608] hover:border-white/10 outline-none transition-all duration-300 placeholder:text-zinc-700 shadow-[inset_0_2px_8px_rgba(0,0,0,0.9)]\"\n                      />\n                    </div>\n\n                    <div>\n                      <div className=\"flex justify-between items-center mb-1\">\n                        <label htmlFor=\"email\" className=\"block text-[8px] font-mono text-zinc-400 uppercase tracking-widest font-semibold\">\n                          Your Email\n                        </label>\n                        <span className=\"text-[7.5px] font-mono text-zinc-600\">CONNECTION CHANNEL *</span>\n                      </div>\n                      <input\n                        id=\"email\"\n                        type=\"email\"\n                        required\n                        value={email}\n                        onChange={(e) => setEmail(e.target.value)}\n                        placeholder=\"alexander@brand.co\"\n                        className=\"w-full bg-[#030304] border border-white/5 focus:border-accent-red/40 text-xs text-white px-3.5 py-3 rounded-lg focus:ring-1 focus:ring-accent-red/30 focus:bg-[#060608] hover:border-white/10 outline-none transition-all duration-300 placeholder:text-zinc-700 shadow-[inset_0_2px_8px_rgba(0,0,0,0.9)]\"\n                      />\n                    </div>\n\n                    <div>\n                      <div className=\"flex justify-between items-center mb-1\">\n                        <label htmlFor=\"company\" className=\"block text-[8px] font-mono text-zinc-400 uppercase tracking-widest font-semibold\">\n                          Brand / Website\n                        </label>\n                        <span className=\"text-[7.5px] font-mono text-zinc-600\">OPTIONAL</span>\n                      </div>\n                      <input\n                        id=\"company\"\n                        type=\"text\"\n                        value={brandName}\n                        onChange={(e) => setBrandName(e.target.value)}\n                        placeholder=\"zenithgrowth.com\"\n                        className=\"w-full bg-[#030304] border border-white/5 focus:border-accent-red/40 text-xs text-white px-3.5 py-3 rounded-lg focus:ring-1 focus:ring-accent-red/30 focus:bg-[#060608] hover:border-white/10 outline-none transition-all duration-300 placeholder:text-zinc-700 shadow-[inset_0_2px_8px_rgba(0,0,0,0.9)]\"\n                      />\n                    </div>\n\n                    <div>\n                      <div className=\"flex justify-between items-center mb-1\">\n                        <label htmlFor=\"notes\" className=\"block text-[8px] font-mono text-zinc-400 uppercase tracking-widest mb-1 font-semibold\">\n                          Inquiry Brief / Objectives\n                        </label>\n                        <span className=\"text-[7.5px] font-mono text-zinc-600\">DESCRIBE STRATEGY</span>\n                      </div>\n                      <textarea\n                        id=\"notes\"\n                        rows={3}\n                        value={notes}\n                        onChange={(e) => setNotes(e.target.value)}\n                        placeholder=\"Describe your design and conversion needs in detail...\"\n                        className=\"w-full bg-[#030304] border border-white/5 focus:border-accent-red/40 text-[11.5px] text-white px-3.5 py-3 rounded-lg focus:ring-1 focus:ring-accent-red/30 focus:bg-[#060608] hover:border-white/10 outline-none transition-all duration-300 resize-none placeholder:text-zinc-700 shadow-[inset_0_2px_8px_rgba(0,0,0,0.9)]\"\n                      />\n                    </div>\n\n                    <button\n                      type=\"submit\"\n                      className=\"w-full cursor-none mt-5 py-3.5 bg-accent-red hover:bg-[#e03227] text-white text-[10px] font-mono tracking-widest uppercase transition-all duration-300 rounded-lg font-bold flex items-center justify-center gap-2 shadow-[0_4px_20px_rgba(201,54,46,0.15)] hover:shadow-[0_4px_30px_rgba(201,54,46,0.35)] active:scale-[0.98]\"\n                    >\n                      SEND BRIEF <Send size={10} />\n                    </button>\n                  </form>"
