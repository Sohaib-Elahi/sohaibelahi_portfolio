    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "      if (rSect < 0.22) {\n        // A. HIGH ACCURACY CENTRAL SLENDER BODY & NOBLE HEAD (22%)\n        sectType = 1;\n        const t = Math.random(); // vertical progress from 0 (bottom of body) to 1 (top of head/beak)\n        \n        if (t < 0.65) {\n          // Slender elegant Torso\n          const progress = t / 0.65;\n          y = -0.55 + 1.25 * progress;\n          // Torso width taper curve\n          const radius = 0.12 * Math.sin(progress * Math.PI);\n          const theta = Math.random() * Math.PI * 2;\n          x = Math.cos(theta) * radius;\n          z = Math.sin(theta) * radius * 0.4;\n        } else if (t < 0.82) {\n          // Slender elegant Neck\n          const progress = (t - 0.65) / 0.17;\n          y = 0.70 + 0.3 * progress;\n          const radius = 0.032;\n          const theta = Math.random() * Math.PI * 2;\n          x = Math.cos(theta) * radius;\n          z = Math.sin(theta) * radius * 0.4;\n        } else {\n          // Sharp Proud Head & Beak looking forward & up\n          const progress = (t - 0.82) / 0.18;\n          y = 1.0 + 0.18 * progress;\n          const radius = 0.055 * Math.sin(progress * Math.PI * 0.5 + 0.5);\n          const theta = Math.random() * Math.PI * 2;\n          x = Math.cos(theta) * radius;\n          z = Math.sin(theta) * radius * 0.6;\n          \n          // Downward-side beak projection\n          if (progress > 0.6) {\n            z += (progress - 0.6) * 0.15;\n            y -= (progress - 0.6) * 0.05;\n          }\n        }\n      } else if (rSect < 0.82) {\n        // B. SYMMETRICAL WINGS WITH INDIVIDUAL FEATHER SPLINES (60%)\n        // High geometric structure, modeled on the sleek outspread reference image\n        const isLeft = Math.random() < 0.5;\n        sectType = isLeft ? 2 : 3;\n        const sign = isLeft ? -1 : 1;\n\n        // 16 distinct feathers per wing\n        const featherID = Math.floor(Math.random() * 16);\n        const u = Math.random(); // progress along the wing bone\n\n        // Wing base bone curving upward elegantly to frame the layout (Expanded span & curvature)\n        const wingX = sign * (0.05 + 1.85 * Math.pow(u, 0.82));\n        const wingY = -0.15 + 1.75 * Math.pow(u, 1.15) + 0.45 * Math.sin(u * Math.PI);\n        const wingZ = -u * 0.15;\n\n        // Precise feather fanning angle calculations to ensure beautiful clean posturing\n        // Feathers radiate down-and-outward on outer parts and back-and-out on inner parts\n        const fNorm = featherID / 15;\n        const angleOffsetRange = fNorm * 0.95 - 0.45;\n        const fanAngle = sign * (1.35 + angleOffsetRange) * 1.57; // Radiate outwards beautifully\n        \n        // Feather tapers elegantly as wing goes outward, mimicking true biological wing profile (Substantially larger)\n        const featherLength = (0.45 + 1.15 * Math.pow(1.0 - u, 0.65)) * (0.15 + 0.85 * Math.random());\n        const v = Math.random(); // progress along individual feather strand\n\n        x = wingX + Math.cos(fanAngle) * featherLength * v;\n        y = wingY + Math.sin(fanAngle) * featherLength * v;\n        z = wingZ + (Math.random() - 0.5) * 0.04 - u * 0.22;\n      } else {\n        // C. CASCADING LONGSWORD TAIL FEATHERS (18%)\n        sectType = 4;\n        const t = Math.random(); // progress along tail blade\n        \n        // 7 distinct beautiful ribbon-like tail strands fanning downwards\n        const strandID = Math.floor(Math.random() * 7);\n        const strandSign = Math.random() < 0.5 ? -1 : 1;\n        const strandFactor = (strandID - 3) * 0.18; // symmetrically fanned x offsets\n\n        const length = 1.45 + 0.45 * Math.random();\n        y = -0.65 - t * length;\n        \n        // Custom curved swooping spline for each tail strand\n        const sweepX = strandFactor * Math.pow(t, 1.25) * 0.88 + (Math.random() - 0.5) * 0.03;\n        x = sweepX;\n        z = (Math.random() - 0.5) * 0.04 - t * 0.15;\n      }"
      replacement_content: "      if (rSect < 0.20) {\n        // A. HIGH ACCURACY CENTRAL BODY, NOBLE HEAD & SYMMETRICAL CRESTS (20%)\n        sectType = 1;\n        const t = Math.random(); // vertical progress from 0 (bottom of body) to 1 (top of head/beak)\n        \n        if (t < 0.55) {\n          // Torso: Muscular fire-shaped teardrop silhouette merging into the hips\n          const progress = t / 0.55;\n          y = -0.55 + 1.15 * progress;\n          // Torso width taper curve fitting the thick, powerful central torso in the reference photo\n          const radius = (0.05 + 0.14 * Math.sin(progress * Math.PI)) * (0.8 + 0.2 * Math.random());\n          const theta = Math.random() * Math.PI * 2;\n          x = Math.cos(theta) * radius;\n          z = Math.sin(theta) * radius * 0.55;\n        } else if (t < 0.78) {\n          // Neck: Thick, graceful flame column\n          const progress = (t - 0.55) / 0.23;\n          y = 0.60 + 0.32 * progress;\n          const radius = (0.045 - 0.012 * progress) * (0.9 + 0.1 * Math.random());\n          const theta = Math.random() * Math.PI * 2;\n          x = Math.cos(theta) * radius;\n          z = Math.sin(theta) * radius * 0.55;\n        } else {\n          // Proud crest head with symmetrical flame-ears / crest-tufts pointing upwards and outwards\n          const progress = (t - 0.78) / 0.22;\n          y = 0.92 + 0.22 * progress;\n          \n          const rHead = Math.random();\n          if (rHead < 0.40) {\n            // Symmetrical Crown Crests flaring outwards from sides of head (horns of flame)\n            const crestSign = Math.random() < 0.5 ? -1 : 1;\n            const uCrest = Math.random();\n            x = crestSign * (0.02 + 0.16 * Math.pow(uCrest, 0.75));\n            y = 1.05 + 0.26 * Math.pow(uCrest, 0.85);\n            z = -0.05 + (Math.random() - 0.5) * 0.02;\n          } else {\n            // Standard central head and piercing forward beak projection\n            const radius = 0.05 * Math.sin((1 - progress) * Math.PI * 0.5);\n            const theta = Math.random() * Math.PI * 2;\n            x = Math.cos(theta) * radius;\n            z = Math.sin(theta) * radius * 0.65;\n            \n            // Frontward-sharp pointed beak\n            if (progress > 0.5) {\n              const beakP = (progress - 0.5) / 0.5;\n              z += beakP * 0.15;\n              y -= beakP * 0.04;\n            }\n          }\n        }\n      } else if (rSect < 0.84) {\n        // B. SYMMETRICAL WINGS WITH OUTER PLUME FLARINGS (64%)\n        // Closely model the wings from the source photo: curving out, thick coverts, and dramatic vertical flaring at the tips.\n        const isLeft = Math.random() < 0.5;\n        sectType = isLeft ? 2 : 3;\n        const sign = isLeft ? -1 : 1;\n        \n        const wingPart = Math.random();\n        const u = Math.random(); // span factor along wing bone (0 to 1)\n\n        // Wing base skeleton curving outwards and dynamically soaring up at the tips\n        const wingX = sign * (0.04 + 1.95 * Math.pow(u, 0.8));\n        // S-shaped curve modeling the high-flying posture of the wings\n        const wingY = -0.12 + 1.25 * Math.pow(u, 1.4) + 0.62 * Math.sin(u * Math.PI);\n        const wingZ = -u * 0.18;\n\n        if (wingPart < 0.55) {\n          // Layer 1: Long structural feathers fanning and draping beautifully down and out\n          const fanAngle = sign * (1.15 + (u * 0.65 - 0.32)) * Math.PI * 0.5;\n          const featherLength = (0.35 + 1.25 * Math.pow(1.0 - u, 0.55)) * (0.2 + 0.8 * Math.random());\n          const v = Math.random();\n          \n          x = wingX + Math.cos(fanAngle) * featherLength * v;\n          y = wingY + Math.sin(fanAngle) * featherLength * v;\n          z = wingZ + (Math.random() - 0.5) * 0.04 - u * 0.15;\n        } else if (wingPart < 0.85) {\n          // Layer 2: Main dense wing coverts (creates the majestic silhouette thickness near body)\n          const angle = sign * (1.6 - u * 0.4) * Math.PI * 0.5;\n          const len = (0.2 + 0.55 * Math.pow(1.0 - u, 0.5)) * Math.random();\n          \n          x = wingX + Math.cos(angle) * len;\n          y = wingY + Math.sin(angle) * len;\n          z = wingZ + 0.08 * (Math.random() - 0.5);\n        } else {\n          // Layer 3: Flaring outer wing tips (upward tongues of fire/smoke)\n          // Near the tips (u > 0.65), feathers sweep straight up like burning dynamic flames in the reference photo\n          const tSpan = 0.65 + u * 0.35;\n          const fx = sign * (0.04 + 1.95 * Math.pow(tSpan, 0.8));\n          const fy = -0.12 + 1.25 * Math.pow(tSpan, 1.4) + 0.62 * Math.sin(tSpan * Math.PI);\n          \n          const flameProg = Math.random();\n          // vertical flaring\n          x = fx + (Math.random() - 0.5) * 0.18;\n          y = fy + flameProg * (0.45 + 0.65 * tSpan);\n          z = -tSpan * 0.18 + (Math.random() - 0.5) * 0.05;\n        }\n      } else {\n        // C. BROAD SHIELD-LIKE CASCADING TAIL FEATHERS (16%)\n        sectType = 4;\n        const t = Math.random(); // progress along tail blade\n        \n        // 9 distinct ribbons fanning outwards symmetrically to match the beautiful shield shape below\n        const strandID = Math.floor(Math.random() * 9);\n        const strandFactor = (strandID - 4) * 0.22; // symmetrically fanned x offsets\n\n        const length = 1.35 + 0.55 * Math.random();\n        y = -0.55 - t * length;\n        \n        // S-curve sweeping elegantly outward on the flanks\n        const sweepX = strandFactor * Math.pow(t, 1.15) * 0.95 + (Math.random() - 0.5) * 0.02;\n        x = sweepX;\n        z = (Math.random() - 0.5) * 0.04 - t * 0.12;\n      }"
    }
