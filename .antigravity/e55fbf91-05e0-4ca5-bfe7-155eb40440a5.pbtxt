    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "      if (rSect < 0.22) {\n        // A. HIGH ACCURACY CENTRAL SLENDER BODY & NOBLE HEAD (22%)\n        sectType = 1;\n        const t = Math.random(); // vertical progress from 0 (bottom of body) to 1 (top of head/beak)\n        \n        if (t < 0.65) {\n          // Slender elegant Torso\n          const progress = t / 0.65;\n          y = -0.4 + 0.85 * progress;\n          // Torso width taper curve\n          const radius = 0.08 * Math.sin(progress * Math.PI);\n          const theta = Math.random() * Math.PI * 2;\n          x = Math.cos(theta) * radius;\n          z = Math.sin(theta) * radius * 0.4;\n        } else if (t < 0.82) {\n          // Slender elegant Neck\n          const progress = (t - 0.65) / 0.17;\n          y = 0.45 + 0.22 * progress;\n          const radius = 0.025;\n          const theta = Math.random() * Math.PI * 2;\n          x = Math.cos(theta) * radius;\n          z = Math.sin(theta) * radius * 0.4;\n        } else {\n          // Sharp Proud Head & Beak looking forward & up\n          const progress = (t - 0.82) / 0.18;\n          y = 0.67 + 0.15 * progress;\n          const radius = 0.042 * Math.sin(progress * Math.PI * 0.5 + 0.5);\n          const theta = Math.random() * Math.PI * 2;\n          x = Math.cos(theta) * radius;\n          z = Math.sin(theta) * radius * 0.6;\n          \n          // Downward-side beak projection\n          if (progress > 0.6) {\n            z += (progress - 0.6) * 0.12;\n            y -= (progress - 0.6) * 0.04;\n          }\n        }\n      } else if (rSect < 0.82) {\n        // B. SYMMETRICAL WINGS WITH INDIVIDUAL FEATHER SPLINES (60%)\n        // High geometric structure, modeled on the sleek outspread reference image\n        const isLeft = Math.random() < 0.5;\n        sectType = isLeft ? 2 : 3;\n        const sign = isLeft ? -1 : 1;\n\n        // 16 distinct feathers per wing\n        const featherID = Math.floor(Math.random() * 16);\n        const u = Math.random(); // progress along the wing bone\n\n        // Wing base bone curving upward elegantly to frame the layout\n        const wingX = sign * (0.05 + 1.25 * Math.pow(u, 0.85));\n        const wingY = -0.15 + 1.22 * Math.pow(u, 1.15) + 0.22 * Math.sin(u * Math.PI);\n        const wingZ = -u * 0.1;\n\n        // Precise feather fanning angle calculations to ensure beautiful clean posturing\n        // Feathers radiate down-and-outward on outer parts and back-and-out on inner parts\n        const fNorm = featherID / 15;\n        const angleOffsetRange = fNorm * 0.8 - 0.35;\n        const fanAngle = sign * (1.18 + angleOffsetRange) * 1.57; // Radiate outwards beautifully\n        \n        // Feather tapers elegantly as wing goes outward, mimicking true biological wing profile\n        const featherLength = (0.24 + 0.82 * Math.pow(1.0 - u, 0.65)) * (0.12 + 0.88 * Math.random());\n        const v = Math.random(); // progress along individual feather strand\n\n        x = wingX + Math.cos(fanAngle) * featherLength * v;\n        y = wingY + Math.sin(fanAngle) * featherLength * v;\n        z = wingZ + (Math.random() - 0.5) * 0.03 - u * 0.15;\n      } else {\n        // C. CASCADING LONGSWORD TAIL FEATHERS (18%)\n        sectType = 4;\n        const t = Math.random(); // progress along tail blade\n        \n        // 7 distinct beautiful ribbon-like tail strands fanning downwards\n        const strandID = Math.floor(Math.random() * 7);\n        const strandSign = Math.random() < 0.5 ? -1 : 1;\n        const strandFactor = (strandID - 3) * 0.14; // symmetrically fanned x offsets\n\n        const length = 0.95 + 0.25 * Math.random();\n        y = -0.45 - t * length;\n        \n        // Custom curved swooping spline for each tail strand\n        const sweepX = strandFactor * Math.pow(t, 1.25) * 0.68 + (Math.random() - 0.5) * 0.02;\n        x = sweepX;\n        z = (Math.random() - 0.5) * 0.03 - t * 0.12;\n      }"
      replacement_content: "      if (rSect < 0.22) {\n        // A. HIGH ACCURACY CENTRAL SLENDER BODY & NOBLE HEAD (22%)\n        sectType = 1;\n        const t = Math.random(); // vertical progress from 0 (bottom of body) to 1 (top of head/beak)\n        \n        if (t < 0.65) {\n          // Slender elegant Torso\n          const progress = t / 0.65;\n          y = -0.55 + 1.25 * progress;\n          // Torso width taper curve\n          const radius = 0.12 * Math.sin(progress * Math.PI);\n          const theta = Math.random() * Math.PI * 2;\n          x = Math.cos(theta) * radius;\n          z = Math.sin(theta) * radius * 0.4;\n        } else if (t < 0.82) {\n          // Slender elegant Neck\n          const progress = (t - 0.65) / 0.17;\n          y = 0.70 + 0.3 * progress;\n          const radius = 0.032;\n          const theta = Math.random() * Math.PI * 2;\n          x = Math.cos(theta) * radius;\n          z = Math.sin(theta) * radius * 0.4;\n        } else {\n          // Sharp Proud Head & Beak looking forward & up\n          const progress = (t - 0.82) / 0.18;\n          y = 1.0 + 0.18 * progress;\n          const radius = 0.055 * Math.sin(progress * Math.PI * 0.5 + 0.5);\n          const theta = Math.random() * Math.PI * 2;\n          x = Math.cos(theta) * radius;\n          z = Math.sin(theta) * radius * 0.6;\n          \n          // Downward-side beak projection\n          if (progress > 0.6) {\n            z += (progress - 0.6) * 0.15;\n            y -= (progress - 0.6) * 0.05;\n          }\n        }\n      } else if (rSect < 0.82) {\n        // B. SYMMETRICAL WINGS WITH INDIVIDUAL FEATHER SPLINES (60%)\n        // High geometric structure, modeled on the sleek outspread reference image\n        const isLeft = Math.random() < 0.5;\n        sectType = isLeft ? 2 : 3;\n        const sign = isLeft ? -1 : 1;\n\n        // 16 distinct feathers per wing\n        const featherID = Math.floor(Math.random() * 16);\n        const u = Math.random(); // progress along the wing bone\n\n        // Wing base bone curving upward elegantly to frame the layout (Expanded span & curvature)\n        const wingX = sign * (0.05 + 1.85 * Math.pow(u, 0.82));\n        const wingY = -0.15 + 1.75 * Math.pow(u, 1.15) + 0.45 * Math.sin(u * Math.PI);\n        const wingZ = -u * 0.15;\n\n        // Precise feather fanning angle calculations to ensure beautiful clean posturing\n        // Feathers radiate down-and-outward on outer parts and back-and-out on inner parts\n        const fNorm = featherID / 15;\n        const angleOffsetRange = fNorm * 0.95 - 0.45;\n        const fanAngle = sign * (1.35 + angleOffsetRange) * 1.57; // Radiate outwards beautifully\n        \n        // Feather tapers elegantly as wing goes outward, mimicking true biological wing profile (Substantially larger)\n        const featherLength = (0.45 + 1.15 * Math.pow(1.0 - u, 0.65)) * (0.15 + 0.85 * Math.random());\n        const v = Math.random(); // progress along individual feather strand\n\n        x = wingX + Math.cos(fanAngle) * featherLength * v;\n        y = wingY + Math.sin(fanAngle) * featherLength * v;\n        z = wingZ + (Math.random() - 0.5) * 0.04 - u * 0.22;\n      } else {\n        // C. CASCADING LONGSWORD TAIL FEATHERS (18%)\n        sectType = 4;\n        const t = Math.random(); // progress along tail blade\n        \n        // 7 distinct beautiful ribbon-like tail strands fanning downwards\n        const strandID = Math.floor(Math.random() * 7);\n        const strandSign = Math.random() < 0.5 ? -1 : 1;\n        const strandFactor = (strandID - 3) * 0.18; // symmetrically fanned x offsets\n\n        const length = 1.45 + 0.45 * Math.random();\n        y = -0.65 - t * length;\n        \n        // Custom curved swooping spline for each tail strand\n        const sweepX = strandFactor * Math.pow(t, 1.25) * 0.88 + (Math.random() - 0.5) * 0.03;\n        x = sweepX;\n        z = (Math.random() - 0.5) * 0.04 - t * 0.15;\n      }"
