        }
        lines {
          text: "        } else {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          float centerSpot = smoothstep(0.85, 0.0, length(p));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          col += vec3(0.06, 0.003, 0.0015) * centerSpot * (0.4 + sin(t * 1.3) * 0.1);"
