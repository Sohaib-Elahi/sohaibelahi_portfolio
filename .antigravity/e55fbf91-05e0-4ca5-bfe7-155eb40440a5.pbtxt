        }
        lines {
          text: "    // =========================================="
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const vsSource = `"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      attribute vec2 position;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
