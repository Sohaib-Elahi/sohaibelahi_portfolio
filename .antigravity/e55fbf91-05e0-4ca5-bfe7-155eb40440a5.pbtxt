curved wing bone spline\n        const wingX = sign * (0.15 + 2.3 * Math.pow(progress, 0.82));\n        const wingArch = Math.sin(progress * Math.PI * 0.55);\n        const wingY = -0.1 + 0.95 * wingArch - 0.35 * Math.pow(wingX, 2) * 0.15;\n        \n        // Dynamic cascading feathers extending outwards & backwards\n        const maxOffsetAngle = -0.15 * sign - (1.1 * (1 - progress) + depth * 0.7) * sign;\n        const featherExtension = 0.25 + 0.85 * Math.pow(1 - progress, 0.45) * (0.35 + 0.65 * Math.random());\n        \n        x = wingX + Math.cos(maxOffsetAngle) * featherExtension;\n        y = wingY + Math.sin(maxOffsetAngle) * featherExtension;\n        z = (Math.random() - 0.5) * 0.12 - progress * 0.35 + (depth * 0.12);\n      } else {\n        // C. MAGNIFICENT SWEEPING TAIL STREAMERS\n        sectType = 3;\n        const ribbonID = Math.floor(Math.random() * 5);\n        const t = Math.random(); // Progress down the tail streamer\n        const tailLength = 1.7 + Math.random() * 0.95;\n        \n        y = -0.4 - t * tailLength;\n        const angleSway = (ribbonID - 2) * 0.16; // Symmetric stream fanout\n        \n        x = Math.sin(y * 2.1 + angleSway) * 0.25 + angleSway * Math.abs(y) * 0.58;\n        z = Math.cos(y * 1.5 + ribbonID) * 0.18;\n      }\n\n      // Store initial locations\n      positions[i * 3] = x;\n      positions[i * 3 + 1] = y;\n      positions[i * 3 + 2] = z;\n\n      initialPositions[i * 3] = x;\n      initialPositions[i * 3 + 1] = y;\n      initialPositions[i * 3 + 2] = z;\n\n      // Dynamic color palette setup (Rose, Crimson, Rich Gold Core highlights)\n      let pColor = cCrimson;\n      const cChance = Math.random();\n      if (sectType === 0) {\n        // Body has burning golden gold / scarlet core sparks\n        pColor = cChance < 0.35 ? cGold : cChance < 0.8 ? cScarlet : cCopper;\n      } else if (sectType === 3) {\n        // Tail streamers fading into rich crimson & dark rose\n        pColor = cChance < 0.4 ? cScarlet : cChance < 0.85 ? cCrimson : cDarkRose;\n      } else {\n        // Wings transition colors outer is crimson inner is copper/gold embers\n        const distanceToCenter = Math.sqrt(x*x + y*y);\n        if (distanceToCenter < 1.0) {\n          pColor = cChance < 0.45 ? cGold : cChance < 0.8 ? cCopper : cScarlet;\n        } else {\n          pColor = cChance < 0.6 ? cCrimson : cChance < 0.9 ? cScarlet : cDarkRose;\n        }\n      }\n\n      colors[i * 3] = pColor.r;\n      colors[i * 3 + 1] = pColor.g;\n      colors[i * 3 + 2] = pColor.b;\n\n      // Sizes configured carefully for elegance\n      sizes[i] = 1.0 + Math.random() * 2.6;\n\n      // Custom attributes for runtime wave motion variables\n      customData[i * 4] = 0.5 + Math.random() * 1.5; // speed multiplier\n      customData[i * 4 + 1] = Math.random() * Math.PI * 2; // initial math phase offset\n      customData[i * 4 + 2] = Math.random() * 0.25; // wave size index\n      customData[i * 4 + 3] = sectType; // Section identifying number\n    }\n\n    geometry.setAttribute(\"position\", new THREE.BufferAttribute(positions, 3));\n    geometry.setAttribute(\"color\", new THREE.BufferAttribute(colors, 3));\n    geometry.setAttribute(\"aSize\", new THREE.BufferAttribute(sizes, 1));\n\n    // High performance shader material to render smooth circular glowing sparks\n    const material = new THREE.PointsMaterial({\n      size: 0.045, // Smaller points for extremely refined, premium celestial feel\n      vertexColors: true,\n      transparent: true,\n      opacity: 0.9,\n      blending: THREE.AdditiveBlending,\n      depthWrite: false,\n    });"
      replacement_content: "    // Procedural generation of Phoenix particles (Hunger Games Mockingjay emblem)\n    const particleCount = 18000;\n    const geometry = new THREE.BufferGeometry();\n    \n    const positions = new Float32Array(particleCount * 3);\n    const initialPositions = new Float32Array(particleCount * 3);\n    const colors = new Float32Array(particleCount * 3);\n    const sizes = new Float32Array(particleCount);\n    const customData = new Float32Array(particleCount * 4); // [speed, offset, angleOffset/rotationDir, particleSectionType]\n\n    // Celestial Fire Color Definitions\n    const cBrightGold = new THREE.Color(\"#f1a80a\"); // Bright glowing gold\n    const cCopperOrange = new THREE.Color(\"#e45311\"); // Rich plasma copper\n    const cDeepCrimson = new THREE.Color(\"#9b090c\"); // Heavy crimson plasma\n    const cDarkRose = new THREE.Color(\"#3c0205\"); // Sophisticated pitch shadow rose\n    const cWhiteSpark = new THREE.Color(\"#ffffff\"); // Super hot core spark\n\n    for (let i = 0; i < particleCount; i++) {\n      let x = 0, y = 0, z = 0;\n      let sectType = 0; // 0=Burning Ring, 1=Body/Head, 2=Left Wing, 3=Right Wing, 4=Tail Streamers\n      const rSect = Math.random();\n\n      if (rSect < 0.40) {\n        // A. THE EMBLEN RING OF FIRE (40%)\n        sectType = 0;\n        const theta = Math.random() * Math.PI * 2;\n        // Burning flared ring radius\n        const radius = 1.95 + (Math.random() - 0.5) * 0.12;\n        \n        // Add fire flares expanding outward\n        const flare = Math.pow(Math.random(), 3.5) * 0.45;\n        const r = radius + flare;\n        \n        x = r * Math.cos(theta);\n        y = r * Math.sin(theta);\n        z = (Math.random() - 0.5) * 0.16 + (Math.random() - 0.5) * flare * 0.4;\n      } else if (rSect < 0.55) {\n        // B. STREAMLINED BIRD BODY & NOBLE HEAD (15%)\n        sectType = 1;\n        const t = Math.random(); // Body progress 0 (bottom) to 1 (head)\n        y = -0.7 + 1.45 * t;\n        \n        // Chest profile - fuller near the center, tapering at top and bottom\n        const bodyWidth = 0.16 * Math.sin(t * Math.PI) * (1.2 - 0.4 * t);\n        x = (Math.random() - 0.5) * bodyWidth;\n        z = (Math.random() - 0.5) * 0.18 * (1.1 - t);\n\n        if (t > 0.88) {\n          // Sharp Noble Head with classic upper-right gazing beak\n          const headProgress = (t - 0.88) / 0.12;\n          x += headProgress * 0.18; // Beak orientation\n          y += headProgress * 0.05;\n        }\n      } else if (rSect < 0.85) {\n        // C. MAJESTIC SYMMETRICAL UPSTRETCHED WINGS (30%)\n        const isLeft = Math.random() < 0.5;\n        sectType = isLeft ? 2 : 3;\n        const sign = isLeft ? -1 : 1;\n        \n        const u = Math.random(); // Bone progress 0 to 1\n        \n        // Sweeping wing-bone line curving gracefully high and back\n        const wingX = sign * (0.08 + 1.62 * Math.pow(u, 0.85));\n        const wingY = -0.15 + 1.68 * Math.pow(u, 1.1) + 0.32 * Math.sin(u * Math.PI);\n        \n        // Feathers fanning outward & downward\n        const featherLength = (0.22 + 0.88 * Math.pow(1.0 - u, 0.6)) * (0.2 + 0.8 * Math.random());\n        // Custom angle so feathers stretch in iconic Mockingjay sharp fanout\n        const fanAngle = sign * (1.15 + 0.82 * (1.0 - u)) * 1.57; // Angle outward\n        \n        x = wingX + Math.cos(fanAngle) * featherLength;\n        y = wingY + Math.sin(fanAngle) * featherLength;\n        z = (Math.random() - 0.5) * 0.1 - u * 0.28;\n      } else {\n        // D. SYMMETRICAL CASCADING TAIL STREAMERS (15%)\n        sectType = 4;\n        const t = Math.random(); // Progress down\n        y = -0.65 - 1.25 * t;\n        \n        // Multi-tier majestic streaming curves expanding symmetrically\n        const streamerTier = Math.floor(Math.random() * 3);\n        const sign = Math.random() < 0.5 ? -1 : 1;\n        \n        const waveX = sign * (0.04 + 0.55 * Math.pow(t, 1.4)) * (0.6 + 0.4 * streamerTier);\n        x = waveX + (Math.random() - 0.5) * 0.06;\n        z = (Math.random() - 0.5) * 0.08 * (1.0 - t);\n      }\n\n      // Store positions\n      positions[i * 3] = x;\n      positions[i * 3 + 1] = y;\n      positions[i * 3 + 2] = z;\n\n      initialPositions[i * 3] = x;\n      initialPositions[i * 3 + 1] = y;\n      initialPositions[i * 3 + 2] = z;\n\n      // Premium Mockingjay Cohesive Fire Color Palette Distribution\n      let pColor = cDeepCrimson;\n      const colRand = Math.random();\n\n      if (sectType === 0) {\n        // Burning Ring: golden flames with hints of dark copper\n        pColor = colRand < 0.5 ? cBrightGold : (colRand < 0.85 ? cCopperOrange : cDeepCrimson);\n        if (colRand < 0.06) pColor = cWhiteSpark; // Tiny hot points\n      } else if (sectType === 1) {\n        // Noble Bird Spine: Hot searing central plasma\n        pColor = colRand < 0.45 ? cWhiteSpark : (colRand < 0.85 ? cBrightGold : cCopperOrange);\n      } else {\n        // Wings & Tail transition from golden hot interior to fading rose tips\n        const radialDist = Math.sqrt(x * x + y * y);\n        if (radialDist < 1.1) {\n          pColor = colRand < 0.5 ? cBrightGold : cCopperOrange;\n        } else if (radialDist < 1.8) {\n          pColor = colRand < 0.6 ? cCopperOrange : cDeepCrimson;\n        } else {\n          pColor = colRand < 0.75 ? cDeepCrimson : cDarkRose;\n        }\n      }\n\n      colors[i * 3] = pColor.r;\n      colors[i * 3 + 1] = pColor.g;\n      colors[i * 3 + 2] = pColor.b;\n\n      // Glowing spark sizing hierarchy\n      sizes[i] = sectType === 1 ? 1.4 + Math.random() * 2.5 : 1.0 + Math.random() * 2.2;\n\n      // Meta parameters for movement simulation\n      customData[i * 4] = 0.65 + Math.random() * 1.35; // speed multiplier\n      customData[i * 4 + 1] = Math.random() * Math.PI * 2; // initial phase\n      customData[i * 4 + 2] = (Math.random() < 0.5 ? -1.0 : 1.0) * (0.15 + Math.random() * 0.4); // rotation direction/factor\n      customData[i * 4 + 3] = sectType; // section type identification\n    }\n\n    geometry.setAttribute(\"position\", new THREE.BufferAttribute(positions, 3));\n    geometry.setAttribute(\"color\", new THREE.BufferAttribute(colors, 3));\n    geometry.setAttribute(\"aSize\", new THREE.BufferAttribute(sizes, 1));\n\n    // High performance shader material to render smooth circular glowing sparks\n    const material = new THREE.PointsMaterial({\n      size: 0.05, // Refined particle sizing for maximum cinematic quality\n      vertexColors: true,\n      transparent: true,\n      opacity: 0.95,\n      blending: THREE.AdditiveBlending,\n      depthWrite: false,\n    });"
