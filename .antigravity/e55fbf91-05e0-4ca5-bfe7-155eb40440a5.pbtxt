        }
        lines {
          text: "      "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const isInteractive = target.closest(\"button, a, input, textarea, select, [role=\'button\'], [data-cursor=\'pointer\']\");"
