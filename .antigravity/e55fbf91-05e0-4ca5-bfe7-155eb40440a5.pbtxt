          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        dot.classList.remove(\"cursor-expand\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
