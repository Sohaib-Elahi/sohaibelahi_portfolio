        }
        lines {
          text: "            const attractionY = (dy / dist) * p.speed * 4.2;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // Seamlessly override Perlin flow orientation with the attractor force vector"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            vx = vx * (1 - force) + attractionX * force;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            vy = vy * (1 - force) + attractionY * force;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
