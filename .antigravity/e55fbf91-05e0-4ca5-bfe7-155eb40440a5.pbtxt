        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    window.addEventListener(\"mousemove\", onMouseMove, { passive: true });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    window.addEventListener(\"mouseover\", onMouseOver, { passive: true });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
