        }
        lines {
          text: "        );"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        vec2 r = vec2("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          fbm(p + 3.0 * q + vec2(1.2, 5.8) + t * 0.04),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          fbm(p + 3.0 * q + vec2(4.7, 1.2) + t * 0.08)"
